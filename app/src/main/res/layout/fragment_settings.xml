<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif-black"
            android:text="守护配置"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <!-- Parameters Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Duration Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设定监测时长"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/duration_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 分钟"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/duration_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="1.0"
                    android:valueTo="240.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/accent_cyan"
                    app:trackColorActive="@color/accent_cyan"
                    app:trackColorInactive="@color/divider_gray" />

                <!-- HR Threshold Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="异常心率报警值"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/hr_threshold_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80 bpm"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/hr_threshold_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="40.0"
                    android:valueTo="150.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/accent_cyan"
                    app:trackColorActive="@color/accent_cyan"
                    app:trackColorInactive="@color/divider_gray" />

                <!-- Alarm Delay Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="报警确认延迟"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/alarm_delay_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 分钟"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/alarm_delay_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="1.0"
                    android:valueTo="5.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/accent_cyan"
                    app:trackColorActive="@color/accent_cyan"
                    app:trackColorInactive="@color/divider_gray" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Options Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/vibrate_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="震动模式"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sound_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="铃声模式"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_btn"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:text="保存并应用设置"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="36dp"
            app:elevation="4dp" />

        <View android:layout_width="match_parent" android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
